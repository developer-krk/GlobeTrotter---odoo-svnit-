# Copy to .env before running the API.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# The dev shell starts MySQL on port 3307 with user root and no password.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=globetrotter

# Change this before deploying anywhere real.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d
