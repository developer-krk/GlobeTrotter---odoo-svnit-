# ================================
# GlobeTrotter - Root .gitignore
# ================================

# ---------- Environment Variables ----------
.env
.env.*
!.env.example

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Build / Production ----------
dist/
build/
.next/
out/
coverage/

# ---------- Frontend ----------
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/

# ---------- Backend ----------
backend/node_modules/
backend/dist/
backend/build/

# ---------- Logs ----------
*.log
logs/

# ---------- Temporary Files ----------
*.tmp
*.temp
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------- IDE / Editor ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml

# ---------- OS Files ----------
.DS_Store
Thumbs.db

# ---------- Testing ----------
coverage/
.nyc_output/

# ---------- Cache ----------
.cache/
.parcel-cache/
.eslintcache

# ---------- Uploads / User Generated Files ----------
backend/uploads/
frontend/uploads/

# ---------- Local Database / DB Files ----------
*.sqlite
*.sqlite3
*.db

# ---------- Secrets / Certificates ----------
*.pem
*.key
*.crt